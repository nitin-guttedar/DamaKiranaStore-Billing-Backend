{
    "name":  "kiranaos-server",
    "version":  "1.0.0",
    "type":  "module",
    "main":  "src/index.js",
    "scripts":  {
                    "start":  "node src/index.js",
                    "dev":  "node --watch src/index.js",
                    "db:migrate":  "node src/db/migrate.js",
                    "db:seed":  "node src/db/seed.js",
                    "bootstrap:admin":  "node ../scripts/bootstrap-superadmin.js",
                    "db:backup":  "node ../scripts/backup.js",
                    "db:restore":  "node ../scripts/restore.js",
                    "test":  "node --test --test-concurrency=1 tests/*.test.js"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "jsonwebtoken":  "^9.0.2",
                         "multer":  "^1.4.5-lts.1",
                         "zod":  "^3.24.2"
                     },
    "engines":  {
                    "node":  "22.x"
                }
}