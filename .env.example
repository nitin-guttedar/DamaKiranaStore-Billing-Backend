# Server Port & Host
PORT=5000
NODE_ENV=development

# Database path (relative to server directory or absolute)
DB_PATH=data/kiranaos.db

# JWT Authentication Secrets
JWT_SECRET=kiranaos_super_jwt_secret_dev_key_2026_xyz987654321
JWT_EXPIRES_IN=24h

# Cryptographic License Engine Secret (Used to sign annual and custom store licenses)
LICENSE_SIGNING_SECRET=kiranaos_license_engine_rsa_or_hmac_secret_2026_very_secure

# Super-admin Initial Bootstrap Key
SUPER_ADMIN_BOOTSTRAP_KEY=kiranaos_bootstrap_admin_secure_pass_2026

# Local Retail Hardware & Printing Defaults
DEFAULT_PRINTER_MODE=58mm
DEFAULT_INVOICE_PREFIX=INV
DEFAULT_CURRENCY=INR
